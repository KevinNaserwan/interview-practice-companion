<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../InterviewPracticeCompanion/Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../InterviewPracticeCompanion/Services/**/*.cs" Exclude="../InterviewPracticeCompanion/Services/AudioCaptureService.cs" Link="Services/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
