<UserControl x:Class="InterviewPracticeCompanion.Views.SuggestionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="{DynamicResource Suggestion}" Style="{StaticResource SectionTitle}"/><TextBlock Text="API hanya dipakai saat Anda meminta saran" Style="{StaticResource Hint}" Margin="0"/></StackPanel><TextBox Grid.Row="1" Text="{Binding Suggestion, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFC" Padding="14" FontSize="15" AutomationProperties.Name="Answer suggestion"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{DynamicResource Copy}" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="{DynamicResource Generate}" Command="{Binding GenerateCommand}" MinWidth="140"/></StackPanel></Grid></UserControl>
