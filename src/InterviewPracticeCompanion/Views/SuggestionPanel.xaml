<UserControl x:Class="InterviewPracticeCompanion.Views.SuggestionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel><TextBlock Text="Suggestion" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Suggestion}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Answer suggestion"/><UniformGrid Columns="2"><Button Content="Copy" Command="{Binding CopyCommand}"/><Button Content="Clear" Command="{Binding ClearCommand}"/></UniformGrid></StackPanel>
</UserControl>
