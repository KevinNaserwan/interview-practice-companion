<UserControl x:Class="InterviewPracticeCompanion.Views.SuggestionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><TextBlock Text="{DynamicResource Suggestion}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource SuggestionHint}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Suggestion, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Answer suggestion"/><UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="{DynamicResource Copy}" Command="{Binding CopyCommand}" Margin="0,0,4,0"/><Button Content="{DynamicResource Clear}" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/></UniformGrid></StackPanel></UserControl>
