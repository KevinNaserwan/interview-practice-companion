<UserControl x:Class="InterviewPracticeCompanion.Views.ConsentDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource ConsentTitle}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ConsentBody}" Style="{StaticResource Hint}"/><CheckBox Content="{DynamicResource ConsentCheckbox}" IsChecked="{Binding ConsentChecked}" IsEnabled="{Binding CanEditSetup}" AutomationProperties.Name="Recording consent"/><Button Content="{DynamicResource ConfirmConsent}" Command="{Binding ConfirmConsentCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="180"/></StackPanel></UserControl>
