<UserControl x:Class="InterviewPracticeCompanion.Views.SessionControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel><ComboBox ItemsSource="{Binding CaptureSources}" SelectedItem="{Binding CaptureSource}" AutomationProperties.Name="Audio source"/><UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Start" Command="{Binding StartCommand}" AutomationProperties.Name="Start listening"/><Button Content="Stop" Command="{Binding StopCommand}" AutomationProperties.Name="Stop listening"/></UniformGrid></StackPanel>
</UserControl>
