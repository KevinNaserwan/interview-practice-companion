<UserControl x:Class="InterviewPracticeCompanion.Views.CodingPrompt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel><TextBlock Text="Coding prompt" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding CodingPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="88" AutomationProperties.Name="Coding prompt"/><ComboBox ItemsSource="{Binding ProgrammingLanguages}" SelectedItem="{Binding ProgrammingLanguage}" AutomationProperties.Name="Programming language"/><Button Content="Generate" Command="{Binding GenerateCommand}"/></StackPanel>
</UserControl>
