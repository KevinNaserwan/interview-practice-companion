<UserControl x:Class="InterviewPracticeCompanion.Views.CodingPrompt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><TextBlock Text="{DynamicResource CodingPrompt}" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding CodingPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="95" AutomationProperties.Name="Coding prompt"/><TextBlock Text="{DynamicResource ProgrammingLanguage}" Margin="0,8,0,2"/><ComboBox ItemsSource="{Binding ProgrammingLanguages}" SelectedItem="{Binding ProgrammingLanguage}" AutomationProperties.Name="Programming language"/><Button Content="{DynamicResource Generate}" Command="{Binding GenerateCommand}" HorizontalAlignment="Right" MinWidth="160"/></StackPanel></UserControl>
