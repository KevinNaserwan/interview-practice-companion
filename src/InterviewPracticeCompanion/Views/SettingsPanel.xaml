<UserControl x:Class="InterviewPracticeCompanion.Views.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
  <TextBlock Text="{DynamicResource ApiKeyLabel}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ApiKeyHint}" Style="{StaticResource Hint}"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="Key" PasswordChanged="Key_Changed" AutomationProperties.Name="API key"/><Button Grid.Column="1" Content="{DynamicResource GetApiKey}" Command="{Binding OpenApiPortalCommand}" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4"/><Button Grid.Column="2" Content="{DynamicResource SaveApiKey}" Command="{Binding SaveApiKeyCommand}" Margin="8,4,0,4" Click="Save_Click"/></Grid>
  <Expander Header="{DynamicResource Settings}" Margin="0,8,0,0"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="{DynamicResource AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource ContentOpacity}"/><Slider Minimum="0.6" Maximum="1" Value="{Binding ContentOpacity}" AutomationProperties.Name="Content opacity"/></StackPanel></Grid></Expander>
</StackPanel></UserControl>
