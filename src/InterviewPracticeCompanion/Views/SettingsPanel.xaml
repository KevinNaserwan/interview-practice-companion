<UserControl x:Class="InterviewPracticeCompanion.Views.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/><PasswordBox x:Name="Key" PasswordChanged="Key_Changed" AutomationProperties.Name="API key"/><Button Content="Save API key securely" Command="{Binding SaveApiKeyCommand}"/><CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}"/><TextBlock Text="Content opacity"/><Slider Minimum="0.6" Maximum="1" Value="{Binding ContentOpacity}" AutomationProperties.Name="Content opacity"/></StackPanel></Border>
</UserControl>
