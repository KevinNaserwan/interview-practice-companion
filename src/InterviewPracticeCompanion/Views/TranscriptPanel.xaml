<UserControl x:Class="InterviewPracticeCompanion.Views.TranscriptPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="{DynamicResource Clear}" Command="{Binding ClearCommand}" Style="{StaticResource QuietButton}"/><StackPanel><TextBlock Text="{DynamicResource Transcript}" Style="{StaticResource SectionTitle}"/><TextBlock Text="Transkripsi berjalan lokal di perangkat" Style="{StaticResource Hint}" Margin="0"/></StackPanel></DockPanel><TextBox Grid.Row="1" Text="{Binding Transcript, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFC" Padding="14" FontSize="15" AutomationProperties.Name="Editable transcript"/></Grid></UserControl>
