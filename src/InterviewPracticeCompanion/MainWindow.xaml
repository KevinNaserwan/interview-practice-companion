<Window x:Class="InterviewPracticeCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:InterviewPracticeCompanion.Views" Title="Interview Practice Companion — Practice Mode" Width="500" Height="820" MinWidth="400" MinHeight="620" Topmost="{Binding AlwaysOnTop}" Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="20" Opacity="{Binding ContentOpacity}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="/InterviewPracticeCompanion;component/Resources/AppLogo.png" Width="54" Height="54" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Interview Practice Companion" FontSize="20" FontWeight="Bold"/><TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{StaticResource TextMuted}"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border Style="{StaticResource Pill}"><TextBlock Text="{DynamicResource PracticeMode}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="{Binding ApiStatus}" HorizontalAlignment="Right" Margin="0,5,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource LanguageLabel}" Style="{StaticResource Hint}"/><UniformGrid Columns="2"><Button Content="🇮🇩  ID" Command="{Binding SetIndonesianCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/><Button Content="🇬🇧  EN" Command="{Binding SetEnglishCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"/></UniformGrid></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource ModeLabel}" Style="{StaticResource Hint}"/><ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="Practice mode"/></StackPanel>
      </Grid></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource SetupTitle}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource SetupHint}" Style="{StaticResource Hint}"/><views:SettingsPanel/><views:SessionControls/><views:ConsentDialog/></StackPanel></Border>
      <Border Background="#EEF0FF" CornerRadius="12" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="{Binding ConsentStatus}" Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Start}" Command="{Binding StartCommand}" Margin="0,0,6,0"/><Button Content="{DynamicResource Stop}" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="0"/></StackPanel></Grid></Border>
      <Border Background="#FCEBED" CornerRadius="10" Padding="12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Retry}" Command="{Binding RetryCommand}" Style="{StaticResource DangerButton}" Margin="12,0,0,0"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/></DockPanel></Border>
      <TextBlock Text="{DynamicResource AudioLevel}" FontSize="12" Foreground="{StaticResource TextMuted}"/><ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Margin="0,5,0,14" Foreground="{StaticResource Accent}" AutomationProperties.Name="Audio level"/>
    </StackPanel>
    <StackPanel Grid.Row="1"><Border Style="{StaticResource Card}"><views:TranscriptPanel/></Border><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCodingMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><views:CodingPrompt/></Border><Border Style="{StaticResource Card}"><views:SuggestionPanel/></Border></StackPanel>
  </Grid></ScrollViewer>
</Window>
