<Window x:Class="InterviewPracticeCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:InterviewPracticeCompanion.Views" Title="Interview Practice Companion — Practice Mode" Width="920" Height="760" MinWidth="720" MinHeight="600" Topmost="{Binding AlwaysOnTop}" Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" Opacity="{Binding ContentOpacity}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource Accent}" Margin="0,0,14,0"><Image Source="/InterviewPracticeCompanion;component/Resources/AppLogo.png" Margin="7"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Interview Practice Companion" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Pill}" Margin="0,0,10,0"><TextBlock Text="{DynamicResource PracticeMode}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border><Border Style="{StaticResource Pill}"><TextBlock Text="{Binding ApiStatus}" Foreground="{StaticResource Accent}" AutomationProperties.LiveSetting="Polite"/></Border></StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="20"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="ID" Command="{Binding SetIndonesianCommand}" Style="{StaticResource SegmentedButton}"/><Button Content="EN" Command="{Binding SetEnglishCommand}" Style="{StaticResource SegmentedButton}"/></StackPanel>
      <ComboBox Grid.Column="1" ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="Practice mode"/>
      <ComboBox Grid.Column="3" ItemsSource="{Binding CaptureSourceOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding CaptureSource}" IsEnabled="{Binding CanEditSetup}" AutomationProperties.Name="Audio source"/>
      <StackPanel Grid.Column="4" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/><ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="5" Margin="0,7,0,0" Foreground="{StaticResource Accent}"/></StackPanel>
      <StackPanel Grid.Column="5" Orientation="Horizontal"><Button Content="{DynamicResource Start}" Command="{Binding StartCommand}" MinWidth="120"/><Button Content="{DynamicResource Stop}" Command="{Binding StopCommand}" Style="{StaticResource QuietButton}" MinWidth="92" Margin="8,4,0,4"/></StackPanel>
    </Grid></Border>

    <StackPanel Grid.Row="2">
      <Border Background="#FFF4F4" BorderBrush="#F4C7CC" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Retry}" Command="{Binding RetryCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/></DockPanel></Border>
      <Expander Header="{DynamicResource SetupTitle}" IsExpanded="True" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><views:SettingsPanel/><views:SessionControls/></StackPanel><views:ConsentDialog Grid.Column="2"/></Grid></Border></Expander>
    </StackPanel>

    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0"><views:TranscriptPanel/></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCodingMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><views:CodingPrompt/></Border><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0"><views:SuggestionPanel/></Border></Grid>
    </Grid>
  </Grid>
</Window>
