<Window x:Class="InterviewPracticeCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:InterviewPracticeCompanion.Views" Title="Interview Practice Companion" Width="1040" Height="720" MinWidth="800" MinHeight="560" Topmost="{Binding AlwaysOnTop}" Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <Grid Opacity="{Binding ContentOpacity}">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/InterviewPracticeCompanion;component/Resources/AppLogo.png" Width="32" Height="32" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Interview Practice Companion" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Latihan privat • transkripsi lokal" Foreground="{StaticResource TextMuted}" FontSize="12"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="ID" Command="{Binding SetIndonesianCommand}" Style="{StaticResource SegmentedButton}"/><Button Content="EN" Command="{Binding SetEnglishCommand}" Style="{StaticResource SegmentedButton}"/><Expander Header="Pengaturan" Margin="16,0,0,0"><Border Style="{StaticResource Card}" Width="420" Margin="0,8,0,0"><views:SettingsPanel/></Border></Expander></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="Practice mode"/>
        <ComboBox Grid.Column="1" Margin="10,4" ItemsSource="{Binding CaptureSourceOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding CaptureSource}" IsEnabled="{Binding CanEditSetup}" AutomationProperties.Name="Audio source"/>
        <StackPanel Grid.Column="2" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/><ProgressBar Value="{Binding AudioLevel}" Minimum="0" Maximum="1" Height="3" Margin="0,5,0,0" Foreground="{StaticResource Accent}"/></StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal"><CheckBox Content="Saya berizin merekam sesi ini" IsChecked="{Binding ConsentChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="{DynamicResource Start}" Command="{Binding StartCommand}" MinWidth="110"/><Button Content="{DynamicResource Stop}" Command="{Binding StopCommand}" Style="{StaticResource QuietButton}"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="24,20,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FFF4F4" BorderBrush="#F4C7CC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Retry}" Command="{Binding RetryCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0"><views:TranscriptPanel/></Border>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCodingMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><views:CodingPrompt/></Border><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0"><views:SuggestionPanel/></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
