<Window x:Class="InterviewPracticeCompanion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:InterviewPracticeCompanion.Views" Title="Interview Practice Companion — Practice Mode" Width="420" Height="720" MinWidth="360" MinHeight="560" Topmost="{Binding AlwaysOnTop}" Background="{StaticResource Surface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="16" Opacity="{Binding ContentOpacity}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><Border Background="{StaticResource Accent}" CornerRadius="10" Padding="10,5"><TextBlock Text="{DynamicResource PracticeMode}" Foreground="White" FontWeight="Bold"/></Border><TextBlock Text="{Binding ApiStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
      <UniformGrid Columns="2"><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" AutomationProperties.Name="Answer language"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Practice mode"/></UniformGrid>
      <TextBlock Text="{DynamicResource EmptyState}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="{Binding Error}" Foreground="#B00020" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <StackPanel Grid.Row="1"><views:SessionControls/><views:ConsentDialog/><ProgressBar Minimum="0" Maximum="1" Height="8" AutomationProperties.Name="Audio level"/><views:TranscriptPanel/><views:CodingPrompt/><views:SuggestionPanel/><views:SettingsPanel/></StackPanel>
  </Grid></ScrollViewer>
</Window>
